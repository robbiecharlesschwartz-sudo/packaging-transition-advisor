# Copy to .env for the Python scripts. Never commit .env.
# Worker secrets are set separately with `npx wrangler secret put <NAME>` (see README).

# Deployed worker URL (used by scripts/embed.py, scripts/ask.py, eval/run_eval.py)
WORKER_URL=http://127.0.0.1:8787

# Shared secret for the worker's /api/admin/* ingest endpoints.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Worker secret (not read by Python): Google AI Studio key for report writing
# GEMINI_API_KEY=

# Optional worker secret: swap generation to Claude by setting LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional: BLS Public Data API v2 key (v1 works without a key at lower limits)
BLS_API_KEY=

# SEC EDGAR asks automated clients for a descriptive User-Agent
SEC_USER_AGENT=packaging-transition-advisor research-script admin@example.org
